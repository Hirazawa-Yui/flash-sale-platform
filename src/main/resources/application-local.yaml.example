# ============================================================================
# 本机私有配置模板
#
# 【使用方法】复制本文件为同目录下的 application-local.yaml，填入你自己的值：
#     cp application-local.yaml.example application-local.yaml
#
# application-local.yaml 已被 .gitignore 排除，不会进版本库。
# 不建这个文件应用也能启动，但数据库和 Redis 密码是空串，连接会失败。
# ============================================================================

spring:
  datasource:
    # 你的 MySQL 密码
    password: your_mysql_password
  redis:
    # 你的 Redis 密码；本地 Redis 没设密码的话留空即可
    password: your_redis_password

# 图片上传根目录 —— 指向 nginx 的静态资源目录，上传的图片由 nginx 提供访问。
# 用正斜杠，Windows 下 Java 的 File 同样能正确解析。
hmdp:
  upload-dir: ./imgs
